# GPT4CLI Environment Variables
# Copy this file to .env and update the values as needed

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Environment mode (development, production)
GOENV=development

# Enable local development mode
LOCAL_MODE=1

# GPT4CLI environment (development, production)
GPT4CLI_ENV=development

# Base directory for GPT4CLI files
GPT4CLI_BASE_DIR=/gpt4cli-server

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Option 1: Full DATABASE_URL (recommended)
DATABASE_URL=postgres://gpt4cli:gpt4cli@localhost:5432/gpt4cli?sslmode=disable

# Option 2: Individual database components (alternative)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=gpt4cli
# DB_PASSWORD=gpt4cli
# DB_NAME=gpt4cli

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server port (default: 8099)
PORT=8099

# Cloud deployment flag
IS_CLOUD=

# App subdomain for cloud deployment
APP_SUBDOMAIN=

# =============================================================================
# AI MODEL API KEYS
# =============================================================================

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenRouter API Key (for multiple providers)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Azure OpenAI API Key
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here

# Google API Key (for Gemini models)
GOOGLE_API_KEY=your-google-api-key-here

# =============================================================================
# EMAIL CONFIGURATION (for notifications)
# =============================================================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Ollama base URL (for local models)
OLLAMA_BASE_URL=http://localhost:11434

# GPT4CLI Cloud flag
GPT4CLI_CLOUD=

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# Development CLI output directory
GPT4CLI_DEV_CLI_OUT_DIR=/usr/local/bin

# Development CLI binary name
GPT4CLI_DEV_CLI_NAME=gpt4cli-dev

# Development CLI alias
GPT4CLI_DEV_CLI_ALIAS=g4cd

# =============================================================================
# NOTES
# =============================================================================

# For Docker development:
# - DATABASE_URL is automatically set by docker-compose
# - Most other variables have sensible defaults
# - Only API keys need to be configured

# For local development:
# - Set up PostgreSQL locally
# - Configure DATABASE_URL with your local credentials
# - Set GOENV=development and LOCAL_MODE=1

# For production:
# - Set GOENV=production
# - Configure all required API keys
# - Set up proper SMTP configuration
# - Configure IS_CLOUD and APP_SUBDOMAIN if using cloud deployment 
